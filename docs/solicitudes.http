
# Taller Mecánico | Solicitudes de prueba para REST Client (VS Code)
#
# Preparación: iniciar la API SQLite temporal indicada en docs/pruebas.md.
# Sustituir @baseUrl por la dirección local impresa en la terminal.
# El puerto 1 es un marcador de seguridad: NO apunta al backend real.
# Enviar las 60 solicitudes de arriba hacia abajo mediante "Send Request".
# Los ID se obtienen de las respuestas previas; no hay ID fijos.
# Los comentarios "Esperado" son una guía, no aserciones automáticas.
# En 204 la respuesta no debe tener cuerpo; en 400/404/409/422 el error debe ser JSON.
# No usar Docker ni PostgreSQL compartido para reproducir esta colección.
# Órdenes de Trabajo no ofrece DELETE.

@baseUrl = http://127.0.0.1:1
@idInexistente = 999999
@clienteId = {{crearCliente.response.body.$.id}}
@vehiculoId = {{crearVehiculo.response.body.$.id}}
@ordenId = {{crearOrden.response.body.$.id}}
@reparacionId = {{crearReparacion.response.body.$.id}}
@clienteBorrableId = {{crearClienteBorrable.response.body.$.id}}
@vehiculoBorrableId = {{crearVehiculoBorrable.response.body.$.id}}


# ------------------------------------------------------------------
# INICIO | Comprobación de disponibilidad
# ------------------------------------------------------------------

### 01. Comprobar que la API responde
# @name salud
# Esperado: 200
GET {{baseUrl}}/
Accept: application/json


# ------------------------------------------------------------------
# CLIENTES | Creación, consulta, actualización y validaciones
# ------------------------------------------------------------------

### 02. Crear cliente
# @name crearCliente
# Esperado: 201
POST {{baseUrl}}/clientes
Accept: application/json
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Pruebas",
  "telefono": "912345678",
  "email": "ana.http@example.com",
  "direccion": "Calle QA 123"
}

### 03. Listar clientes con filtro y paginación
# @name listarClientes
# Esperado: 200
GET {{baseUrl}}/clientes?nombre=Ana&ordenar_por=apellido&direccion=asc&pagina=1&limite=10
Accept: application/json

### 04. Consultar cliente creado
# @name obtenerCliente
# Esperado: 200
GET {{baseUrl}}/clientes/{{clienteId}}
Accept: application/json

### 05. Actualizar teléfono del cliente
# @name actualizarCliente
# Esperado: 200
PATCH {{baseUrl}}/clientes/{{clienteId}}
Accept: application/json
Content-Type: application/json

{
  "telefono": "987654321"
}

### 06. Rechazar correo duplicado — CLIENT_EMAIL_ALREADY_EXISTS
# @name clienteDuplicado
# Esperado: 409
POST {{baseUrl}}/clientes
Accept: application/json
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Pruebas",
  "telefono": "912345678",
  "email": "ana.http@example.com",
  "direccion": "Calle QA 123"
}

### 07. Rechazar email inválido — VALIDATION_ERROR
# @name clienteInvalido
# Esperado: 422
POST {{baseUrl}}/clientes
Accept: application/json
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Pruebas",
  "telefono": "912345678",
  "email": "invalido",
  "direccion": "Calle QA 123"
}

### 08. Rechazar teléfono inválido — VALIDATION_ERROR
# @name clientePatchInvalido
# Esperado: 422
PATCH {{baseUrl}}/clientes/{{clienteId}}
Accept: application/json
Content-Type: application/json

{
  "telefono": "1"
}

### 09. Consultar cliente inexistente — CLIENT_NOT_FOUND
# @name clienteNoExiste
# Esperado: 404
GET {{baseUrl}}/clientes/{{idInexistente}}
Accept: application/json


# ------------------------------------------------------------------
# VEHÍCULOS | Creación, consulta, actualización y validaciones
# ------------------------------------------------------------------

### 10. Crear vehículo del cliente
# @name crearVehiculo
# Esperado: 201
POST {{baseUrl}}/vehiculos/
Accept: application/json
Content-Type: application/json

{
  "patente": "QA0001",
  "marca": "Toyota",
  "modelo": "Yaris",
  "anio": 2020,
  "kilometraje": 120000,
  "cliente_id": {{clienteId}}
}

### 11. Listar vehículos
# @name listarVehiculos
# Esperado: 200
GET {{baseUrl}}/vehiculos/
Accept: application/json

### 12. Consultar vehículo creado
# @name obtenerVehiculo
# Esperado: 200
GET {{baseUrl}}/vehiculos/{{vehiculoId}}
Accept: application/json

### 13. Actualizar kilometraje
# @name actualizarVehiculo
# Esperado: 200
PATCH {{baseUrl}}/vehiculos/{{vehiculoId}}
Accept: application/json
Content-Type: application/json

{
  "kilometraje": 120001
}

### 14. Rechazar patente duplicada — VEHICLE_LICENSE_PLATE_ALREADY_EXISTS
# @name vehiculoDuplicado
# Esperado: 409
POST {{baseUrl}}/vehiculos/
Accept: application/json
Content-Type: application/json

{
  "patente": "QA0001",
  "marca": "Toyota",
  "modelo": "Yaris",
  "anio": 2020,
  "kilometraje": 120000,
  "cliente_id": {{clienteId}}
}

### 15. Rechazar cliente inexistente — CLIENT_NOT_FOUND
# @name vehiculoSinCliente
# Esperado: 404
POST {{baseUrl}}/vehiculos/
Accept: application/json
Content-Type: application/json

{
  "patente": "QA9999",
  "marca": "Toyota",
  "modelo": "Yaris",
  "anio": 2020,
  "kilometraje": 120000,
  "cliente_id": {{idInexistente}}
}

### 16. Rechazar kilometraje negativo — VALIDATION_ERROR
# @name vehiculoInvalido
# Esperado: 422
POST {{baseUrl}}/vehiculos/
Accept: application/json
Content-Type: application/json

{
  "patente": "QA0001",
  "marca": "Toyota",
  "modelo": "Yaris",
  "anio": 2020,
  "kilometraje": -1,
  "cliente_id": {{clienteId}}
}

### 17. Rechazar patente corta — VALIDATION_ERROR
# @name vehiculoPatchInvalido
# Esperado: 422
PATCH {{baseUrl}}/vehiculos/{{vehiculoId}}
Accept: application/json
Content-Type: application/json

{
  "patente": "ABC"
}

### 18. Consultar vehículo inexistente — VEHICLE_NOT_FOUND
# @name vehiculoNoExiste
# Esperado: 404
GET {{baseUrl}}/vehiculos/{{idInexistente}}
Accept: application/json

### 19. Impedir eliminar cliente con vehículos — CLIENT_HAS_VEHICLES
# @name clienteConVehiculo
# Esperado: 409
DELETE {{baseUrl}}/clientes/{{clienteId}}
Accept: application/json


# ------------------------------------------------------------------
# ÓRDENES DE TRABAJO | Creación, consulta, estados y filtros
# ------------------------------------------------------------------

### 20. Crear orden de trabajo pendiente
# @name crearOrden
# Esperado: 201
POST {{baseUrl}}/ordenes-trabajo
Accept: application/json
Content-Type: application/json

{
  "vehiculo_id": {{vehiculoId}},
  "fecha_ingreso": "2024-01-10",
  "descripcion_problema": "Revisar frenos del vehiculo",
  "estado": "pendiente",
  "kilometraje_ingreso": 120000
}

### 21. Filtrar, ordenar y paginar órdenes
# @name listarOrdenes
# Esperado: 200
GET {{baseUrl}}/ordenes-trabajo?estado=pendiente&ordenar_por=fecha_ingreso&direccion=desc&pagina=1&limite=10
Accept: application/json

### 22. Consultar orden creada
# @name obtenerOrden
# Esperado: 200
GET {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json

### 23. Cambiar estado a en_reparacion
# @name actualizarOrden
# Esperado: 200
PATCH {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json
Content-Type: application/json

{
  "estado": "en_reparacion"
}

### 24. Rechazar vehículo inexistente — VEHICLE_NOT_FOUND
# @name ordenSinVehiculo
# Esperado: 404
POST {{baseUrl}}/ordenes-trabajo
Accept: application/json
Content-Type: application/json

{
  "vehiculo_id": {{idInexistente}},
  "fecha_ingreso": "2024-01-10",
  "descripcion_problema": "Revisar frenos del vehiculo",
  "estado": "pendiente",
  "kilometraje_ingreso": 120000
}

### 25. Rechazar kilometraje negativo — VALIDATION_ERROR
# @name ordenInvalida
# Esperado: 422
POST {{baseUrl}}/ordenes-trabajo
Accept: application/json
Content-Type: application/json

{
  "vehiculo_id": {{vehiculoId}},
  "fecha_ingreso": "2024-01-10",
  "descripcion_problema": "Revisar frenos del vehiculo",
  "estado": "pendiente",
  "kilometraje_ingreso": -1
}

### 26. Rechazar estado desconocido — VALIDATION_ERROR
# @name ordenPatchInvalido
# Esperado: 422
PATCH {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json
Content-Type: application/json

{
  "estado": "abierta"
}

### 27. Rechazar vehículo inexistente al actualizar — VEHICLE_NOT_FOUND
# @name ordenPatchSinVehiculo
# Esperado: 404
PATCH {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json
Content-Type: application/json

{
  "vehiculo_id": {{idInexistente}}
}

### 28. Consultar orden inexistente — WORK_ORDER_NOT_FOUND
# @name ordenNoExiste
# Esperado: 404
GET {{baseUrl}}/ordenes-trabajo/{{idInexistente}}
Accept: application/json

### 29. Rechazar actualización de orden inexistente — WORK_ORDER_NOT_FOUND
# @name ordenPatchNoExiste
# Esperado: 404
PATCH {{baseUrl}}/ordenes-trabajo/{{idInexistente}}
Accept: application/json
Content-Type: application/json

{
  "estado": "finalizada"
}


# ------------------------------------------------------------------
# REPARACIONES | Creación, consulta, actualización y validaciones
# ------------------------------------------------------------------

### 30. Crear reparación para la orden
# @name crearReparacion
# Esperado: 201
POST {{baseUrl}}/reparaciones/
Accept: application/json
Content-Type: application/json

{
  "orden_trabajo_id": {{ordenId}},
  "descripcion": "Cambio de pastillas de freno",
  "tipo": "mantencion",
  "costo": 45000,
  "fecha": "2024-01-11"
}

### 31. Listar reparaciones
# @name listarReparaciones
# Esperado: 200
GET {{baseUrl}}/reparaciones/
Accept: application/json

### 32. Consultar reparación creada
# @name obtenerReparacion
# Esperado: 200
GET {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json

### 33. Actualizar costo de la reparación
# @name actualizarReparacion
# Esperado: 200
PATCH {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json
Content-Type: application/json

{
  "costo": 50000
}

### 34. Rechazar orden inexistente — WORK_ORDER_NOT_FOUND
# @name reparacionSinOrden
# Esperado: 404
POST {{baseUrl}}/reparaciones/
Accept: application/json
Content-Type: application/json

{
  "orden_trabajo_id": {{idInexistente}},
  "descripcion": "Cambio de pastillas de freno",
  "tipo": "mantencion",
  "costo": 45000,
  "fecha": "2024-01-11"
}

### 35. Rechazar costo negativo — VALIDATION_ERROR
# @name reparacionInvalida
# Esperado: 422
POST {{baseUrl}}/reparaciones/
Accept: application/json
Content-Type: application/json

{
  "orden_trabajo_id": {{ordenId}},
  "descripcion": "Cambio de pastillas de freno",
  "tipo": "mantencion",
  "costo": -1,
  "fecha": "2024-01-11"
}

### 36. Rechazar tipo desconocido — VALIDATION_ERROR
# @name reparacionPatchInvalido
# Esperado: 422
PATCH {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json
Content-Type: application/json

{
  "tipo": "otro"
}

### 37. Rechazar fecha futura al crear — INVALID_REPAIR_DATE
# @name reparacionFechaFutura
# Esperado: 400
POST {{baseUrl}}/reparaciones/
Accept: application/json
Content-Type: application/json

{
  "orden_trabajo_id": {{ordenId}},
  "descripcion": "Cambio de pastillas de freno",
  "tipo": "mantencion",
  "costo": 45000,
  "fecha": "9999-12-31"
}

### 38. Rechazar fecha futura al actualizar — INVALID_REPAIR_DATE
# @name reparacionPatchFechaFutura
# Esperado: 400
PATCH {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json
Content-Type: application/json

{
  "fecha": "9999-12-31"
}

### 39. Consultar reparación inexistente — REPAIR_NOT_FOUND
# @name reparacionNoExiste
# Esperado: 404
GET {{baseUrl}}/reparaciones/{{idInexistente}}
Accept: application/json


# ------------------------------------------------------------------
# REGLAS DE NEGOCIO | Integridad, estados y entradas inválidas
# ------------------------------------------------------------------

### 40. Impedir eliminar vehículo con órdenes — VEHICLE_HAS_WORK_ORDERS
# @name vehiculoConOrden
# Esperado: 409
DELETE {{baseUrl}}/vehiculos/{{vehiculoId}}
Accept: application/json

### 41. Verificar que se conserva el vehículo
# @name verificarVehiculoConservado
# Esperado: 200
GET {{baseUrl}}/vehiculos/{{vehiculoId}}
Accept: application/json

### 42. Verificar que se conserva la orden
# @name verificarOrdenConservada
# Esperado: 200
GET {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json

### 43. Finalizar la orden
# @name finalizarOrden
# Esperado: 200
PATCH {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json
Content-Type: application/json

{
  "estado": "finalizada"
}

### 44. Impedir reabrir orden a pendiente — INVALID_WORK_ORDER_STATE
# @name reabrirOrdenPendiente
# Esperado: 409
PATCH {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json
Content-Type: application/json

{
  "estado": "pendiente"
}

### 45. Impedir reabrir orden a en_reparacion — INVALID_WORK_ORDER_STATE
# @name reabrirOrdenReparacion
# Esperado: 409
PATCH {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json
Content-Type: application/json

{
  "estado": "en_reparacion"
}

### 46. Verificar que la orden sigue finalizada
# @name verificarOrdenFinalizada
# Esperado: 200
GET {{baseUrl}}/ordenes-trabajo/{{ordenId}}
Accept: application/json

### 47. Rechazar identificador no numérico — VALIDATION_ERROR
# @name idInvalido
# Esperado: 422
GET {{baseUrl}}/ordenes-trabajo/no-es-un-id
Accept: application/json

### 48. Rechazar página cero — VALIDATION_ERROR
# @name paginaInvalida
# Esperado: 422
GET {{baseUrl}}/clientes?pagina=0
Accept: application/json

### 49. Rechazar ordenamiento desconocido — VALIDATION_ERROR
# @name ordenamientoInvalido
# Esperado: 422
GET {{baseUrl}}/ordenes-trabajo?ordenar_por=inexistente
Accept: application/json


# ------------------------------------------------------------------
# ELIMINACIÓN | Comprobar 204 y 404 sin alterar la cadena principal
# ------------------------------------------------------------------

### 50. Crear cliente independiente para probar DELETE
# @name crearClienteBorrable
# Esperado: 201
POST {{baseUrl}}/clientes
Accept: application/json
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Pruebas",
  "telefono": "912345678",
  "email": "borrable.http@example.com",
  "direccion": "Calle QA 123"
}

### 51. Eliminar cliente existente (sin cuerpo)
# @name borrarCliente
# Esperado: 204
DELETE {{baseUrl}}/clientes/{{clienteBorrableId}}
Accept: application/json

### 52. Consultar cliente eliminado — CLIENT_NOT_FOUND
# @name consultarClienteBorrado
# Esperado: 404
GET {{baseUrl}}/clientes/{{clienteBorrableId}}
Accept: application/json

### 53. Repetir DELETE de cliente inexistente — CLIENT_NOT_FOUND
# @name borrarClienteOtraVez
# Esperado: 404
DELETE {{baseUrl}}/clientes/{{clienteBorrableId}}
Accept: application/json

### 54. Crear vehículo sin órdenes para probar DELETE
# @name crearVehiculoBorrable
# Esperado: 201
POST {{baseUrl}}/vehiculos/
Accept: application/json
Content-Type: application/json

{
  "patente": "QA0002",
  "marca": "Toyota",
  "modelo": "Yaris",
  "anio": 2020,
  "kilometraje": 120000,
  "cliente_id": {{clienteId}}
}

### 55. Eliminar vehículo existente (sin cuerpo)
# @name borrarVehiculo
# Esperado: 204
DELETE {{baseUrl}}/vehiculos/{{vehiculoBorrableId}}
Accept: application/json

### 56. Consultar vehículo eliminado — VEHICLE_NOT_FOUND
# @name consultarVehiculoBorrado
# Esperado: 404
GET {{baseUrl}}/vehiculos/{{vehiculoBorrableId}}
Accept: application/json

### 57. Repetir DELETE de vehículo inexistente — VEHICLE_NOT_FOUND
# @name borrarVehiculoOtraVez
# Esperado: 404
DELETE {{baseUrl}}/vehiculos/{{vehiculoBorrableId}}
Accept: application/json

### 58. Eliminar reparación existente (sin cuerpo)
# @name borrarReparacion
# Esperado: 204
DELETE {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json

### 59. Consultar reparación eliminada — REPAIR_NOT_FOUND
# @name consultarReparacionBorrada
# Esperado: 404
GET {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json

### 60. Repetir DELETE de reparación inexistente — REPAIR_NOT_FOUND
# @name borrarReparacionOtraVez
# Esperado: 404
DELETE {{baseUrl}}/reparaciones/{{reparacionId}}
Accept: application/json
